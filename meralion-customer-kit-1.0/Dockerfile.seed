# Small CPU image for infra/seed-model.sh: downloads the model from Hugging Face into Blob.
# The 9 GB runtime image does not fit on a Consumption CPU node's disk.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "huggingface_hub>=0.30,<1" azure-identity==1.23.0 azure-storage-blob==12.25.1 && \
    groupadd --gid 10001 app && \
    useradd --uid 10001 --gid app --create-home --home-dir /app/home app && \
    chown -R app:app /app
COPY --chown=app:app model_service /app/model_service
USER app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
ENTRYPOINT ["python3", "/app/model_service/weights.py"]
