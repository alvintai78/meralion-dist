FROM python:3.12-slim

WORKDIR /app

COPY requirements.cpu.txt /app/requirements.cpu.txt
RUN pip install --no-cache-dir -r /app/requirements.cpu.txt && \
    groupadd --gid 10001 app && \
    useradd --uid 10001 --gid app --create-home --home-dir /app/home app && \
    chown -R app:app /app

COPY --chown=app:app model_service /app/model_service

USER app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)"

ENTRYPOINT ["python", "-m", "model_service.cpu_entrypoint"]