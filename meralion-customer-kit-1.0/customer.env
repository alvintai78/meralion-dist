# Copy to ../customer.env (repository root) and fill in. Plain KEY=VALUE lines only.
# Variables already set in your shell take precedence over this file.

# Required
TENANT_ID=8b10e051-c7f1-4674-9177-d8c300577d35
SUBSCRIPTION_ID=57bbd325-81fb-4c5f-adee-489263236d32

# Region must offer Consumption-GPU-NC24-A100 and you need A100 quota there
# (run infra/preflight.sh to check).
LOCATION=westus3
RESOURCE_GROUP=rg-meralion

# Optional. Defaults shown; ACR and storage names must be globally unique and
# lowercase alphanumeric, so SUFFIX defaults to the first 8 hex chars of the subscription id.
# SUFFIX=
# ENVIRONMENT_NAME=cae-meralion
# CPU_APP_NAME=ca-meralion
# GPU_APP_NAME=ca-meralion-gpu
# GPU_PROFILE_NAME=A100GPU-Profile
# IDENTITY_NAME=id-meralion-aca
# ACR_NAME=acrmeralion<suffix>
# STORAGE_NAME=stmeralion<suffix>

# Runtime version you will pack in step 5 of the deployment guide.
RUNTIME_VERSION=v1-vllm-cu130

# Audio used by the cold-start benchmark: local file, and its name inside the audio container.
AUDIO_FILE=./samples/short.wav
BLOB_NAME=compatibility/short.wav
